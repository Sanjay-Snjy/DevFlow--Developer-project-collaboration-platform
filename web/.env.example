# The browser talks directly to the Node API on this origin.
# CORS_ORIGINS on the backend must include this origin.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Where the Next.js dev/proxy server sends /api and /socket.io traffic.
API_PROXY_TARGET=http://localhost:4000

# ── Clerk ────────────────────────────────────────────────────────
# From dashboard.clerk.com → API Keys (values starting with pk_test_/sk_test_).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Optional route hints (defaults shown)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
