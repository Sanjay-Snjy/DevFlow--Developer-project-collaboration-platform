# ── DevFlow backend ──────────────────────────────────────────────
# Server
PORT=4000
NODE_ENV=development
# Comma separated list of allowed browser origins for CORS (used when the web
# app talks to this API cross-origin; empty allows same-origin via the Next.js
# /api proxy only).
CORS_ORIGINS=http://localhost:3000
# Set "true" when running behind a trusted reverse proxy (cookie/rate-limit IPs)
TRUST_PROXY=false

# Database
# docker compose MongoDB → mongodb://127.0.0.1:27017/devflow
MONGODB_URI=mongodb://127.0.0.1:27017/devflow

# Auth — Clerk owns sign-in. The API verifies Clerk session JWTs (Bearer) against
# these credentials and provisions a local user record on first request.
# Keys come from dashboard.clerk.com → API Keys. JWT_SECRET is no longer used.
CLERK_PUBLISHABLE_KEY=pk_test_Y2FyZWZ1bC1yYXZlbi0xODE5LmNsZXJrLmFjY291bnRzLmRldiQ
CLERK_SECRET_KEY=sk_test_FtATo3mwf0gKEiVTqXIOfqUcp8w13cdQ6xQBzNnm4R
# Test-only: set "true" to let the API accept dev_test_ tokens from test helpers.
AUTH_TEST_MODE=false
# Cookie flags (legacy; only COOKIE_SECURE/COOKIE_DOMAIN remain, unused by Clerk auth)
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ── GitHub integration ───────────────────────────────────────────
# Server-side token (fine-grained PAT with repo read scope) used to read public
# repo data when the acting user has no connected GitHub account.
GITHUB_TOKEN=
# OAuth app credentials enabling users to "Connect GitHub account".
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public base URL of this backend (used to build OAuth redirect URLs).
PUBLIC_API_URL=http://localhost:4000

# ── AI ───────────────────────────────────────────────────────────
# Shared secret between backend and the python-ai service.
AI_SERVICE_KEY=devflow-ai-shared-secret
# Base URL of the Python AI service.
AI_API_URL=http://127.0.0.1:8000
# Outbound timeout for AI calls (ms)
AI_TIMEOUT_MS=90000
