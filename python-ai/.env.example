# ── DevFlow AI service ────────────────────────────────────────────
# Provider: openai-compatible chat completions API.
#   AI_PROVIDER=openai | none   (auto = openai when an API key is set)
# Leave AI_API_KEY empty to run the rest of DevFlow without AI features —
# the API answers 503 AI_NOT_CONFIGURED and the UI shows a friendly notice.
AI_PROVIDER=auto
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Shared secret that the Node backend must present (X-Service-Key).
AI_SERVICE_KEY=devflow-ai-shared-secret
PORT=8000
